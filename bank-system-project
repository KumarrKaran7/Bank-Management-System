"""
Simple Bank Management System (No login / No OTP)
----------------------------------------------------
OOP concepts demonstrated:
  - Abstraction        : Account is an ABC, withdraw() is abstract
  - Encapsulation       : balance is private, exposed only via a read-only property
  - Inheritance         : SavingsAccount, CurrentAccount, FixedAccount extend Account
  - Polymorphism        : each subclass overrides withdraw() with its own rules
  - Protocol / Duck typing : Notifier is a typing.Protocol - any object with a
                             notify(message) method can subscribe to an account
  - Operator overloading : __lt__, __gt__, __eq__, __repr__, __del__

Naming convention used in comments (matches classroom style):
  #~#  section marker      #%  protected attribute
  #*   public attribute     #!  private attribute
  #?   note / explanation   #^  data structure note
"""

from __future__ import annotations
from abc import ABC, abstractmethod
from typing import Protocol, runtime_checkable
from datetime import datetime


# ---------------------------------------------------------------------------
# ~# Notification system -> Observer pattern implemented via typing.Protocol
# ---------------------------------------------------------------------------
@runtime_checkable
class Notifier(Protocol):
    """Structural interface. ANY class with a matching notify() method
    automatically satisfies this Protocol - no explicit inheritance needed."""

    def notify(self, message: str) -> None: ...


class ConsoleNotifier:
    """Prints alerts straight to the console."""

    def notify(self, message: str) -> None:
        print(f"[CONSOLE ALERT] {message}")


class SMSNotifier:
    def __init__(self, phone_number: str):
        self.phone_number = phone_number

    def notify(self, message: str) -> None:
        print(f"[SMS -> {self.phone_number}] {message}")


class EmailNotifier:
    def __init__(self, email: str):
        self.email = email

    def notify(self, message: str) -> None:
        print(f"[EMAIL -> {self.email}] {message}")


# ---------------------------------------------------------------------------
# ~# Base Account class (abstract)
# ---------------------------------------------------------------------------
class Account(ABC):
    """Abstract base class shared by every account type."""

    # ~# Class level attribute - a SINGLE copy shared by every instance
    last_account_number: int = 1000000000

    def __init__(self, holders_name: str, balance: float):
        if balance < 0:
            raise ValueError("Initial balance cannot be negative")

        Account.last_account_number += 1

        self._account_number: int = Account.last_account_number   # % protected
        self.holders_name: str = holders_name                      # * public
        self.__balance: float = 0.0                                # ! private (name-mangled)
        self.transactions: list[tuple[str, float, str, str]] = []  # ? (desc, amount, DR/CR, timestamp)
        self.__notifiers: list[Notifier] = []                      # ! private observer list

        self.__balance = balance
        self._log_transaction("Initial deposit", balance, "CR")

    # ---------------- Balance protection ----------------
    @property
    def balance(self) -> float:
        """Read-only property. There is intentionally NO public setter, so
        code like `account.balance = 99999` raises AttributeError. Balance
        can only ever change through deposit()/withdraw()/interest logic."""
        return self.__balance

    def _adjust_balance(self, amount: float) -> None:
        """Protected internal mutator. Only Account and its subclasses may
        call this - it is NOT part of the public API."""
        self.__balance += amount

    # ---------------- Notification (Observer) ----------------
    def subscribe(self, notifier: Notifier) -> None:
        if not isinstance(notifier, Notifier):
            raise TypeError("notifier must implement notify(message: str)")
        self.__notifiers.append(notifier)

    def unsubscribe(self, notifier: Notifier) -> None:
        if notifier in self.__notifiers:
            self.__notifiers.remove(notifier)

    def _notify_all(self, message: str) -> None:
        for n in self.__notifiers:
            n.notify(message)

    # ---------------- Transaction logging ----------------
    def _log_transaction(self, description: str, amount: float, txn_type: str) -> None:
        timestamp = datetime.now().strftime("%d-%m-%Y %H:%M:%S")
        self.transactions.append((description, amount, txn_type, timestamp))

    # ---------------- Core operations ----------------
    def deposit(self, description: str, amount: float) -> None:
        if amount <= 0:
            raise ValueError("Deposit amount must be positive")
        self._adjust_balance(amount)
        self._log_transaction(description, amount, "CR")
        self._notify_all(f"Deposit of Rs.{amount:.2f} successful. New balance: Rs.{self.balance:.2f}")

    @abstractmethod
    def withdraw(self, description: str, amount: float) -> None:
        """Every account type enforces its own withdrawal rules."""
        ...

    # ---------------- Operator overloading ----------------
    def __lt__(self, other: "Account") -> bool:
        return self.balance < other.balance

    def __gt__(self, other: "Account") -> bool:
        return self.balance > other.balance

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, Account):
            return NotImplemented
        return self.balance == other.balance

    def __repr__(self) -> str:
        return f"{self.__class__.__name__}(#{self._account_number}, {self.holders_name}, Rs.{self.balance:.2f})"

    def __del__(self):
        print(f"Account of {self.holders_name} closed / removed from memory")

    # ---------------- Display ----------------
    def print_statement(self) -> None:
        print("-" * 72)
        print(f"Account Type : {self.__class__.__name__}")
        print(f"Account #    : {self._account_number}")
        print(f"Holder       : {self.holders_name}")
        print(f"Balance      : Rs.{self.balance:.2f}")
        print("-" * 72)
        counter = 1
        for desc, amount, txn_type, ts in self.transactions:
            print(f"{counter:05d} {desc:<22} {amount:>12.2f} {txn_type}  {ts}")
            counter += 1
        print("-" * 72)


# ---------------------------------------------------------------------------
# ~# SavingsAccount
# ---------------------------------------------------------------------------
class SavingsAccount(Account):
    MIN_BALANCE = 1000.0
    INTEREST_RATE = 0.04  # 4% flat, demo only

    def withdraw(self, description: str, amount: float) -> None:
        if amount <= 0:
            raise ValueError("Withdrawal amount must be positive")
        if self.balance - amount < self.MIN_BALANCE:
            raise Exception(
                f"Withdrawal denied: Savings account must maintain a minimum "
                f"balance of Rs.{self.MIN_BALANCE:.2f}"
            )
        self._adjust_balance(-amount)
        self._log_transaction(description, amount, "DR")
        self._notify_all(f"Withdrawal of Rs.{amount:.2f} successful. New balance: Rs.{self.balance:.2f}")

    def add_interest(self) -> None:
        interest = self.balance * self.INTEREST_RATE
        self._adjust_balance(interest)
        self._log_transaction("Interest credited", interest, "CR")
        self._notify_all(f"Interest of Rs.{interest:.2f} credited. New balance: Rs.{self.balance:.2f}")


# ---------------------------------------------------------------------------
# ~# CurrentAccount (business account - allows overdraft)
# ---------------------------------------------------------------------------
class CurrentAccount(Account):
    def __init__(self, holders_name: str, balance: float, overdraft_limit: float = 5000.0):
        super().__init__(holders_name, balance)
        self.overdraft_limit = overdraft_limit

    def withdraw(self, description: str, amount: float) -> None:
        if amount <= 0:
            raise ValueError("Withdrawal amount must be positive")
        if self.balance - amount < -self.overdraft_limit:
            raise Exception(f"Withdrawal denied: exceeds overdraft limit of Rs.{self.overdraft_limit:.2f}")
        self._adjust_balance(-amount)
        self._log_transaction(description, amount, "DR")
        self._notify_all(f"Withdrawal of Rs.{amount:.2f} successful. New balance: Rs.{self.balance:.2f}")


# ---------------------------------------------------------------------------
# ~# FixedAccount (Fixed Deposit - locked until maturity)
# ---------------------------------------------------------------------------
class FixedAccount(Account):
    def __init__(self, holders_name: str, balance: float, tenure_months: int):
        super().__init__(holders_name, balance)
        self.tenure_months = tenure_months
        self.__matured = False  # ! private

    def mature(self) -> None:
        """Call once the tenure is complete to unlock the deposit."""
        self.__matured = True
        self._notify_all(f"Fixed deposit matured. Rs.{self.balance:.2f} is now withdrawable.")

    def deposit(self, description: str, amount: float) -> None:
        # Fixed deposits don't accept top-up deposits after opening
        raise Exception("Fixed Deposit accounts do not accept additional deposits")

    def withdraw(self, description: str, amount: float) -> None:
        if not self.__matured:
            raise Exception(f"Withdrawal denied: Fixed Deposit is locked for {self.tenure_months} months")
        if amount > self.balance:
            raise Exception("Insufficient balance")
        self._adjust_balance(-amount)
        self._log_transaction(description, amount, "DR")
        self._notify_all(f"Withdrawal of Rs.{amount:.2f} successful. New balance: Rs.{self.balance:.2f}")


# ---------------------------------------------------------------------------
# ~# Demo / driver code
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    savings = SavingsAccount("Guido van Rossum", 10000.00)
    current = CurrentAccount("Ada Lovelace", 2000.00, overdraft_limit=3000.00)
    fixed = FixedAccount("Alan Turing", 50000.00, tenure_months=12)

    # Attach notifiers -- observer pattern, works with ANY object that has notify()
    savings.subscribe(ConsoleNotifier())
    savings.subscribe(SMSNotifier("+91-9XXXXXXXXX"))
    current.subscribe(EmailNotifier("ada@example.com"))
    fixed.subscribe(ConsoleNotifier())

    print("\n===== SAVINGS ACCOUNT =====")
    savings.deposit("Salary", 5000)
    savings.withdraw("Groceries", 2000)
    savings.add_interest()
    savings.print_statement()

    print("\n===== CURRENT ACCOUNT =====")
    current.withdraw("Vendor payment", 4000)  # dips into overdraft
    current.print_statement()

    print("\n===== FIXED ACCOUNT =====")
    try:
        fixed.withdraw("Emergency", 1000)  # blocked - not matured yet
    except Exception as e:
        print(f"Error: {e}")
    fixed.mature()
    fixed.withdraw("Post-maturity withdrawal", 1000)
    fixed.print_statement()

    print("\n===== BALANCE PROTECTION TEST =====")
    try:
        savings.balance = 999999  # AttributeError - no public setter exists
    except AttributeError as e:
        print(f"Blocked direct balance change: {e}")

    print("\n===== COMPARISON (operator overloading) =====")
    print(f"Is savings > current? {savings > current}")
    print(f"repr(savings): {savings!r}")
